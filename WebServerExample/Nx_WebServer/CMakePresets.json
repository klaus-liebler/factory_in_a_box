{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMSIS_Dvendor": "STMicroelectronics:13",
                "CMSIS_Dname": "STM32H573IIK6",
                "CMSIS_Dcore": "Cortex-M33",
                "CMSIS_Dtz": "TZ",
                "CMSIS_Dfpu": "SP_FPU",
                "CMSIS_Ddsp": "DSP",
                "CMSIS_Dmve": "NO_MVE",
                "CMSIS_Dmpu": "MPU",
                "CMSIS_Dendian": "Little-endian",
                "CMSIS_Dsecure": "",
                "CMSIS_Tcompiler": "GCC"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CUBE_CMAKE_C_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-std=gnu11;-g3;-DDEBUG;-DFX_INCLUDE_USER_DEFINE_FILE;-DNX_INCLUDE_USER_DEFINE_FILE;-DTX_INCLUDE_USER_DEFINE_FILE;-DTX_SINGLE_MODE_NON_SECURE=1;-DUSE_HAL_DRIVER;-DSTM32H573xx;-O0;-ffunction-sections;-fdata-sections;-Wall;-fstack-usage",
                "CUBE_CMAKE_CXX_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-std=gnu++14;-g3;-DDEBUG;-DFX_INCLUDE_USER_DEFINE_FILE;-DNX_INCLUDE_USER_DEFINE_FILE;-DTX_INCLUDE_USER_DEFINE_FILE;-DTX_SINGLE_MODE_NON_SECURE=1;-DUSE_HAL_DRIVER;-DSTM32H573xx;-O0;-ffunction-sections;-fdata-sections;-fno-exceptions;-fno-rtti;-fno-use-cxa-atexit;-Wall;-fstack-usage",
                "CUBE_CMAKE_ASM_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-g3;-DDEBUG;-DTX_SINGLE_MODE_NON_SECURE=1;-x;assembler-with-cpp",
                "CUBE_CMAKE_EXE_LINKER_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-TSTM32H573IIKX_FLASH.ld;--specs=nosys.specs;-Wl,-Map=Nx_WebServer.map;-Wl,--gc-sections;-static"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CUBE_CMAKE_C_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-std=gnu11;-DFX_INCLUDE_USER_DEFINE_FILE;-DNX_INCLUDE_USER_DEFINE_FILE;-DTX_INCLUDE_USER_DEFINE_FILE;-DTX_SINGLE_MODE_NON_SECURE=1;-DUSE_HAL_DRIVER;-DSTM32H573xx;-Os;-ffunction-sections;-fdata-sections;-Wall;-fstack-usage",
                "CUBE_CMAKE_CXX_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-std=gnu++14;-DFX_INCLUDE_USER_DEFINE_FILE;-DNX_INCLUDE_USER_DEFINE_FILE;-DTX_INCLUDE_USER_DEFINE_FILE;-DTX_SINGLE_MODE_NON_SECURE=1;-DUSE_HAL_DRIVER;-DSTM32H573xx;-Os;-ffunction-sections;-fdata-sections;-fno-exceptions;-fno-rtti;-fno-use-cxa-atexit;-Wall;-fstack-usage",
                "CUBE_CMAKE_ASM_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-DTX_SINGLE_MODE_NON_SECURE=1;-x;assembler-with-cpp",
                "CUBE_CMAKE_EXE_LINKER_FLAGS": "-mfpu=fpv5-sp-d16;-mfloat-abi=hard;-mthumb;--specs=nano.specs;-mcpu=cortex-m33;-TSTM32H573IIKX_FLASH.ld;--specs=nosys.specs;-Wl,-Map=Nx_WebServer.map;-Wl,--gc-sections;-static"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}