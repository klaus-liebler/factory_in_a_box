{
  "name": "firmware_factory_control_unit",
  "private": true,
  "type": "module",
  "description": "Build-Orchestrator (s. docs/build-process.md) -- npm-Workspace-Root, damit builder/ auf web/'s devDependencies (terser, html-minifier-terser) zugreifen kann.",
  "workspaces": [
    "web"
  ],
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.36.0",
    "vite": "^6.0.0"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const t='builder/src/environment-config.ts.template',r='builder/src/environment-config.ts';if(!fs.existsSync(r)){fs.copyFileSync(t,r);console.log('Angelegt: '+r+' (aus environment-config.ts.template, s. docs/build-process.md)');}\"",
    "phase:hardware-ids:lazy": "node builder/src/cli.ts ReadHardwareIDsAndGenerateFilesAndCertsLazy",
    "phase:hardware-ids:forced": "node builder/src/cli.ts ReadHardwareIDsAndGenerateFilesAndCertsForced",
    "phase:register-map": "node builder/src/cli.ts ReadModbusRegisterMapAndGenerateFiles",
    "phase:git-status": "node builder/src/cli.ts ReadGitStatusAndGenerateFiles",
    "phase:copy": "node builder/src/cli.ts CopyGeneratedFilesToBuildDirectory",
    "phase:build-web": "node builder/src/cli.ts BuildWebApp",
    "phase:build-firmware": "node builder/src/cli.ts BuildFirmware",
    "phase:flash": "node builder/src/cli.ts FlashFirmware",
    "pipeline:lazy": "node builder/src/cli.ts pipeline:lazy",
    "pipeline:forced": "node builder/src/cli.ts pipeline:forced",
    "pipeline:flash": "node builder/src/cli.ts pipeline:flash"
  }
}
