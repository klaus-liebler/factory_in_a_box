{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],

    "sourceMap": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "experimentalDecorators": true,
    // Erforderlich fuer Lit-Decorators (@state/@property) OHNE "accessor"-Keyword: mit
    // target=esnext defaultet TS sonst auf useDefineForClassFields=true, wodurch jede
    // Klassenfeld-Initialisierung (z.B. "private statusMessage = ...") eine eigene
    // Instanz-Property anlegt, die den von Lits Decorator auf dem Prototyp definierten
    // Getter/Setter ueberschattet -- Zuweisungen loesen dann NIE ein Re-Render aus, obwohl
    // this.statusMessage korrekt den neuen Wert zeigt (klassischer, schwer zu findender Bug).
    "useDefineForClassFields": false
  }
}
