{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc16",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/rtoos/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "RTOS_GCC_ROOT": "C:/opt/msys64/ucrt64",
        "RTOS_CONTRACT_SEMANTIC": "quick_enforce"
      },
      "environment": {
        "PATH": "C:/opt/msys64/ucrt64/bin;$penv{PATH}"
      }
    },
    {
      "name": "rev1",
      "displayName": "FCU revision 1 (first boards, STM32H563), release",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "FCU_HAL": "rev1"
      }
    },
    {
      "name": "rev1-debug",
      "displayName": "FCU revision 1 (first boards, STM32H563), debug",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FCU_HAL": "rev1"
      }
    },
    {
      "name": "rev2",
      "displayName": "FCU revision 2 (STM32H563, CH224K), release",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "FCU_HAL": "rev2"
      }
    },
    {
      "name": "rev2-debug",
      "displayName": "FCU revision 2 (STM32H563, CH224K), debug",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FCU_HAL": "rev2"
      }
    },
    {
      "name": "rev3",
      "displayName": "FCU revision 3 (STM32H743), release",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "FCU_HAL": "rev3"
      }
    },
    {
      "name": "rev3-debug",
      "displayName": "FCU revision 3 (STM32H743), debug",
      "inherits": "gcc16",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FCU_HAL": "rev3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rev1",
      "configurePreset": "rev1"
    },
    {
      "name": "rev1-debug",
      "configurePreset": "rev1-debug"
    },
    {
      "name": "rev2",
      "configurePreset": "rev2"
    },
    {
      "name": "rev2-debug",
      "configurePreset": "rev2-debug"
    },
    {
      "name": "rev3",
      "configurePreset": "rev3"
    },
    {
      "name": "rev3-debug",
      "configurePreset": "rev3-debug"
    }
  ]
}
