
#include "gpio.hh"
#include "log.h"
#include "main.h"

#include "stm32g431xx.h"
#include "stm32g4xx_hal.h"
#include "stm32g4xx_hal_gpio.h"
#include "stm32g4xx_hal_spi.h"

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <string_view>
#include "hx711.hh"

extern SPI_HandleTypeDef hspi3;


// HX711 instance
HX711* g_hx711 = nullptr;

enum class AppState {
  INIT,
  CALIBRATION_STEP1_WAITING,
  CALIBRATION_STEP1_MEASURING,
  CALIBRATION_STEP2_WAITING,
  CALIBRATION_STEP2_MEASURING,
  RUNNING,
  ERROR
};

volatile AppState app_state = AppState::INIT;
volatile uint32_t step_start_time = 0;




extern "C" void app_setup(void) {
  log_info("Starting app setup with HX711 calibration");
  
  // Create HX711 instance
  static HX711 hx711(hspi3, Channel_And_Gain::CH_A_GAIN_128);
  g_hx711 = &hx711;
  
  // Initialize HX711
  hx711.setup();
  
  app_state = AppState::CALIBRATION_STEP1_WAITING;
  log_info("=================================");
  log_info("HX711 CALIBRATION PROCEDURE");
  log_info("=================================");
  log_info("STEP 1: Please REMOVE any load from the scale");
  log_info("Waiting 5 seconds before measurement...");
  step_start_time = HAL_GetTick();
}
int64_t last_weight_measurement_time = 0;

extern "C" void app_loop(void) {
  if (g_hx711 == nullptr) {
    log_error("HX711 not initialized");
    return;
  }
  
  uint32_t elapsed = HAL_GetTick() - step_start_time;
  
  switch (app_state) {
    case AppState::INIT:
      break;
    
    case AppState::CALIBRATION_STEP1_WAITING:
      // Let HX711 loop run
      g_hx711->loop();
      
      if (elapsed >= 5000) {
        log_info("Starting measurement for calibration point 1 (0g)...");
        app_state = AppState::CALIBRATION_STEP1_MEASURING;
        step_start_time = HAL_GetTick();
      }
      break;
    
    case AppState::CALIBRATION_STEP1_MEASURING:
      g_hx711->loop();
      
      if (elapsed >= 3000) {
        // Get reading for 0g
        double reading_0g = 0.0;
        if (g_hx711->getLastReadingA(&reading_0g)) {
          log_info("Calibration point 1 captured: %f (should be 0g)", reading_0g);
          // Manually set calibration point
          g_hx711->Calibration(0, Channel_And_Gain::CH_A_GAIN_128, 0.0);
          
          log_info("=================================");
          log_info("STEP 2: Please LOAD the scale with 100g");
          log_info("Waiting 5 seconds before measurement...");
          app_state = AppState::CALIBRATION_STEP2_WAITING;
          step_start_time = HAL_GetTick();
        }
      }
      break;
    
    case AppState::CALIBRATION_STEP2_WAITING:
      g_hx711->loop();
      
      if (elapsed >= 5000) {
        log_info("Starting measurement for calibration point 2 (100g)...");
        app_state = AppState::CALIBRATION_STEP2_MEASURING;
        step_start_time = HAL_GetTick();
      }
      break;
    
    case AppState::CALIBRATION_STEP2_MEASURING:
      g_hx711->loop();
      
      if (elapsed >= 3000) {
        // Get reading for 100g
        double reading_100g = 0.0;
        if (g_hx711->getLastReadingA(&reading_100g)) {
          log_info("Calibration point 2 captured: %f (should be 100g)", reading_100g);
          // Manually set calibration point
          g_hx711->Calibration(1, Channel_And_Gain::CH_A_GAIN_128, 100.0);
          
          log_info("=================================");
          log_info("CALIBRATION COMPLETE!");
          log_info("=================================");
          log_info("Starting continuous measurements...");
          app_state = AppState::RUNNING;
          step_start_time = HAL_GetTick();
        }
      }
      break;
    
    case AppState::RUNNING:
      g_hx711->loop();
      
      // Display measurements every 2 seconds
      if (elapsed >= 2000) {
        double weight = 0.0;
        if (g_hx711->getLastReadingA(&weight)) {
          log_info("Current weight (Channel A, Gain 128): %.2f g", weight);
        }
        step_start_time = HAL_GetTick();
      }
      break;
    
    case AppState::ERROR:
      log_error("App error state");
      break;
  }
}
