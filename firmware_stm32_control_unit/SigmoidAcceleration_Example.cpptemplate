// ============================================================================
// BEISPIEL 3: Prescaler-Berechnung zur Compile-Zeit
// ============================================================================

// Berechne den Prescaler zur Compile-Zeit
constexpr uint32_t CPU_FREQUENCY_HZ = 170000000;  // 170 MHz
constexpr uint16_t MIN_SPEED = 100;               // steps/s

constexpr uint16_t PRESCALER = calculatePrescalerFromMinSpeed(
    CPU_FREQUENCY_HZ,
    MIN_SPEED
);

// Die resultierende Timer-Frequenz:
constexpr uint32_t TIMER_FREQUENCY_HZ = CPU_FREQUENCY_HZ / (PRESCALER + 1);

// Überprüfung: Stelle sicher, dass ARR bei der minimalen Geschwindigkeit 
// nicht größer als 65535 ist
static_assert(
    TIMER_FREQUENCY_HZ / MIN_SPEED <= 65535,
    "Prescaler zu groß: ARR-Wert würde 65535 überschreiten"
);

