{
  "compilerOptions": {
    // "bundler" statt "nodenext": das Projekt laeuft nie unter Nodes nativem ESM-Loader (Vite
    // bundelt fuers Firmware-Flash-Asset, s. docs/build-process.md), und "nodenext" scheitert an
    // der ogl-Bibliothek (deren types/index.d.ts-Barrel intern extensionlose Relativ-Imports
    // nutzt, was unter "nodenext" strikt verboten ist -- "bundler" ahmt stattdessen nach, wie
    // Vite/Rollup tatsaechlich aufloesen, und ist damit fuer ein gebundeltes Browser-Projekt die
    // korrektere Wahl). Bestehende Imports mit expliziter ".js"-Endung bleiben unter "bundler"
    // weiterhin gueltig (dort nur optional, nicht verboten).
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],

    "sourceMap": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "experimentalDecorators": true,
    // Erforderlich fuer Lit-Decorators (@state/@property) OHNE "accessor"-Keyword: mit
    // target=esnext defaultet TS sonst auf useDefineForClassFields=true, wodurch jede
    // Klassenfeld-Initialisierung (z.B. "private statusMessage = ...") eine eigene
    // Instanz-Property anlegt, die den von Lits Decorator auf dem Prototyp definierten
    // Getter/Setter ueberschattet -- Zuweisungen loesen dann NIE ein Re-Render aus, obwohl
    // this.statusMessage korrekt den neuen Wert zeigt (klassischer, schwer zu findender Bug).
    "useDefineForClassFields": false
  }
}
