(* @cycles 6 *)
FUNCTION CLAMP_ADD : INT
VAR_INPUT a : INT; b : INT; lo : INT := -100; hi : INT := 100; END_VAR
CLAMP_ADD := LIMIT(lo, a + b, hi);
END_FUNCTION
FUNCTION POLY : LREAL
VAR_INPUT x : LREAL; END_VAR
VAR c : ARRAY[0..3] OF LREAL := [1.0, -2.0, 0.5, 0.25]; i : INT; END_VAR
FOR i := 3 TO 0 BY -1 DO POLY := POLY * x + c[i]; END_FOR;
END_FUNCTION
FUNCTION SWAP2 : BOOL
VAR_IN_OUT a : DINT; b : DINT; END_VAR
VAR t : DINT; END_VAR
t := a; a := b; b := t; SWAP2 := a > b;
END_FUNCTION
FUNCTION DEPTH : DINT
VAR_INPUT n : DINT; END_VAR
DEPTH := n + POLY_INT(n);
END_FUNCTION
FUNCTION POLY_INT : DINT
VAR_INPUT n : DINT; END_VAR
POLY_INT := LREAL_TO_DINT(POLY(DINT_TO_LREAL(n)));
END_FUNCTION
PROGRAM PLC_PRG
VAR s : INT; p : LREAL; x : DINT := 5; y : DINT := 9; g : BOOL; d : DINT; END_VAR
s := CLAMP_ADD(a := s, b := 37); s := CLAMP_ADD(a := s, b := -5, hi := 120);
p := POLY(INT_TO_LREAL(s) / 10.0);
g := SWAP2(x, y);
d := DEPTH(x);
END_PROGRAM
