/*
1. PYTHON-SKRIPT AUSFÜHREN:
   python sigmoid_approximation.py
   
   Das Skript gibt eine Lookup-Tabelle ähnlich dieser aus:
   ```
   Seg  Steps   D.ARR     End-Time [ms]  End-ARR  Max Abw.  Schritt
   1    25      -10240    12.5           20000    15        10
   2    30      -12800    25.3           18000    20        15
   ...
   ```

2. TABELLE IN SigmoidLookupTables.hpp EINFÜGEN:
   
   Die Werte für acceleration_table_100_1000_05s ersetzen:
   
   constexpr std::array<AccelerationSegment, 2> acceleration_table_100_1000_05s = {{
       AccelerationSegment{
           .steps = 25,
           .arr_slope = -10240,  // D.ARR aus Python-Ausgabe
           .end_time = 12500,    // End-Time [ms] * timer_freq / 1000
           .end_arr = 20000,     // End-ARR
           .max_deviation = 15,  // Max Abw.
           .max_deviation_step = 10
       },
       AccelerationSegment{
           .steps = 30,
           .arr_slope = -12800,
           .end_time = 25300,
           .end_arr = 18000,
           .max_deviation = 20,
           .max_deviation_step = 15
       },
   }};

3. IM FIRMWARE-CODE NUTZEN:
   
   // Globale Variable
   static SigmoidAccelerationProfile accel(
       41666,      // Timer-Frequenz (170MHz / 4096)
       100,        // Start-Speed
       1000,       // Target-Speed
       10          // Shift-Bits
   );
   
   void init() {
       accel.setLookupTable(acceleration_table_100_1000_05s.data());
       accel.reset();
   }
   
   void TIM1_IRQHandler() {
       TIM1->ARR = accel.getNextARR();
       TIM1->SR &= ~TIM_SR_UIF;
   }

4. ÜBERPRÜFUNG:
   - Stelle sicher, dass der Prescaler korrekt berechnet ist
   - Die Timer-Frequenz sollte so sein, dass ARR bei minimaler Geschwindigkeit <= 65535 ist
   - Nutze die constexpr Funktionen für Compile-Time Überprüfung
*/

