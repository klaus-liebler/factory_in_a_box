% Titelei:
\DeclareRobustCommand\runningtitle[1]{\gdef\@runningtitle{#1}}

\def\subtitle#1{\def\@subtitle{#1}}

\let\@authors\relax \let\@@authors\relax
\let\@affils\relax

\def\author#1#2{%
  \ifx\@authors\relax
    \def\@authors{#2\textsuperscript{#1}}%
    \def\@@authors{#2}%
  \else
    \csgappto{@authors}{, #2\textsuperscript{#1}}%
    \csgappto{@@authors}{, #2}%
  \fi}

\def\affil#1#2{%
  \ifx\@authors\relax
    \def\@affils{\footnotetext[#1]{#2}}%
  \else
    \csgappto{@affils}{\footnotetext[#1]{#2}}%
  \fi}

\def\maketitle{%
  \thispagestyle{title}%
  \bgroup
    \null\vskip-\baselineskip
    \raggedright
    \bgroup
      \Huge\bfseries
      \@title\par
      \vskip16.5bp
    \egroup
    \ifx\@subtitle\@undefined\else
      \bgroup
        \huge\bfseries
        \@subtitle\par
        \vskip13bp
      \egroup
    \fi
    \bgroup
      \Large
      \@authors\par
    \egroup
    \@affils
  \egroup
  \ifx\@runningtitle\@undefined\global\let\@runningtitle\@title\fi}

